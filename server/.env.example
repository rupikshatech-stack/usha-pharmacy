# Copy to .env (shared) and/or .env.development / .env.production (per environment).
# Variables already set in the real environment take priority over these files.

NODE_ENV=development
PORT=4000

# Browser origin(s) allowed to call the API. Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Leave EMPTY in development to use the embedded local database.
# REQUIRED in production (use a replica set, e.g. MongoDB Atlas, because transactions are used).
MONGODB_URI=

# Secret used to sign access tokens. REQUIRED in production, at least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Authentication (all optional; defaults shown) ---
# Access tokens are short-lived; the browser renews them silently with a rotating refresh token.
ACCESS_TOKEN_MINUTES=15
# Session length without "Remember me", and with it.
SESSION_HOURS=12
REMEMBER_ME_DAYS=30
# Cookie SameSite policy: lax (default), strict, or none (needed only if the web app and API are on
# different sites; requires HTTPS). COOKIE_SECURE defaults to true in production.
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# Account lockout after repeated wrong passwords.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Initial administrator, created by `npm run seed` (never by the web app) ---
ADMIN_ORG_NAME=Usha Pharmacy
ADMIN_NAME=Usha Admin
ADMIN_EMAIL=admin@example.com
# Choose a strong password: 8-72 chars with upper, lower, number and symbol. Never commit it.
ADMIN_INITIAL_PASSWORD=
# true = the administrator must set a new password at first sign-in (recommended).
ADMIN_REQUIRE_PASSWORD_CHANGE=true

# --- Platform administrator (used only by `node scripts/create-platform-admin.js`) ---
# The one account that can create NEW organizations. It belongs to no organization and cannot read any
# pharmacy's data. It is created with a forced password change, so this password is good for one sign-in only.
PLATFORM_ADMIN_NAME=Platform Operator
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_INITIAL_PASSWORD=

# --- AI Billing (optional) ---
# Uploaded supplier invoices are stored on disk (never served directly; only through an authenticated endpoint) in UPLOAD_DIR.
# Default: server/uploads (keep it out of source control and back it up with the database).
UPLOAD_DIR=
# Reading an invoice (PDF / image) needs an OCR / AI service; none is built in. AI_BILLING_PROVIDER chooses one:
#   http                         - any service you run that accepts the file as the request body and returns JSON (set AI_BILLING_URL, optionally AI_BILLING_API_KEY)
#   (aws-textract | azure-document-intelligence are planned and not connected yet)
# Leave both empty to use AI Billing with upload and manual review only. The JSON shape is documented in services/invoiceExtraction/index.js.
AI_BILLING_PROVIDER=
AI_BILLING_URL=
AI_BILLING_API_KEY=

# --- AI Billing, Phase 2: OCR with Google Cloud Document AI (optional; server-side only, never sent to the browser) ---
# Steps: enable the "Cloud Document AI API"; create a processor (Document OCR, or Invoice Parser for detected fields); create a service account with the
# "Document AI API User" role and download its JSON key to a folder OUTSIDE the project (or one that is git-ignored). NEVER commit the key file.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# OCR_PROVIDER=google-document-ai          (the default; other providers can be added behind the same interface)
# GOOGLE_DOCUMENT_AI_PROCESSOR_VERSION=    pin a processor version
# GOOGLE_DOCUMENT_AI_IMAGE_QUALITY=true    ask for blur/quality scores where the processor supports them
# OCR_TIMEOUT_MS=120000                    how long to wait for Google before reporting a timeout
# OCR_RATE_LIMIT=30                        scans a person may start per 10 minutes

# --- AI Billing, Phase 3: AI invoice extraction from the OCR text (optional; keys stay on the server) ---
# AI_EXTRACTION_PROVIDER=gemini            gemini | openai (default: whichever key is set, Gemini first)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_EXTRACTION_TIMEOUT_MS=120000

# --- AI Billing, Phase 4: product matching thresholds (optional; the defaults are shown) ---
# PRODUCT_MATCH_AUTO_THRESHOLD=0.90        a candidate at or above this, with no conflicts or warnings, is "Matched"
# PRODUCT_MATCH_REVIEW_THRESHOLD=0.55      at or above this it "Needs review"; below it the row is "Unmatched"
# PRODUCT_MATCH_SUGGESTION_FLOOR=0.35      weaker candidates are not suggested
# PRODUCT_MATCH_MAX_SUGGESTIONS=5
# PRODUCT_MATCH_AMBIGUITY_MARGIN=0.04      two good candidates this close make the row "Needs review"

# --- Credit Management (optional; the defaults are shown) ---
# CREDIT_RUPEES_PER_CREDIT=5        rupees per credit when the organization has not set its own rate (CREDIT_CONVERSION_RATE works too)
# CREDIT_SCREENSHOT_MAX_MB=5        largest payment screenshot
# CREDIT_MAX_AMOUNT=1000000         largest single payment amount (rupees)
# CREDIT_RATE_LIMIT=20              requests a person may submit per 10 minutes
