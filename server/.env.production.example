# Production template. Copy to .env.production on the server, or set these in your host's dashboard.
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://your-frontend-domain.example
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/usha_pharmacy?retryWrites=true&w=majority
JWT_SECRET=

# Same site (app and API under one domain): keep lax. Different sites: set none (HTTPS only).
COOKIE_SAME_SITE=lax

# Used once by `npm run seed`, then remove it from the server.
ADMIN_INITIAL_PASSWORD=
ADMIN_REQUIRE_PASSWORD_CHANGE=true
