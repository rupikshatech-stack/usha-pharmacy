{
  "name": "usha-server",
  "version": "1.0.0",
  "description": "Usha Pharmacy API",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "seed:expiry": "node scripts/seed-expiry-demo.js",
    "migrate": "node scripts/migrate-tenancy.js && node scripts/migrate-dashboard.js && node scripts/migrate-inventory.js && node scripts/migrate-transfers.js && node scripts/migrate-suppliers.js && node scripts/migrate-analytics.js && node scripts/migrate-expiry.js && node scripts/migrate-settings.js && node scripts/migrate-roles.js --apply && node scripts/migrate-expiry-alerts.js --apply",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
