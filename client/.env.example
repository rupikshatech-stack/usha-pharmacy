# Copy to .env.local. Only variables prefixed VITE_ are exposed to the browser — never put secrets here.

# API base URL used by the browser. Leave empty in development: requests go to /api and Vite proxies them.
# In production set the full API URL, e.g. https://api.example.com/api
VITE_API_URL=

# Where the dev server proxies /api to (development only).
VITE_DEV_API_TARGET=http://localhost:4000
